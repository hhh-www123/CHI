# 服务端配置；复制为 .env，填写 Key 后重启。不要提交 .env。
AGENT_MODE=llm
LLM_BASE_URL=https://api.deepseek.com
# 请填写服务商实际支持的模型标识；下列名称为项目既有默认值。
LLM_MODEL=deepseek-flash
LLM_MODEL_LABEL=DeepSeek-V4.1-Flash-1017
LLM_API_KEY=
LLM_TIMEOUT=70
LLM_MAX_TOKENS=6000

# 高德「Web服务」Key：用于真实地点、交通路线和静态路线地图。
# 不填写时保留地图搜索入口，明确显示路线数据未连接。
AMAP_KEY=
MAP_TIMEOUT=8

# HTTPS 上线时改为 true。ALLOWED_ORIGINS 填实际站点源。
COOKIE_SECURE=false
ALLOWED_ORIGINS=
AGENT_REQUESTS_PER_MINUTE=12

# Phase 2 受限候选编辑；与上方城市规划 AGENT_MODE 独立。
# 默认 mock 不消耗模型额度；网页也可显式切换 mock/llm。
CANDIDATE_AGENT_MODE=mock
# 候选只在内存暂存，有效期秒数30..3600，重启后需重新生成。
CANDIDATE_TTL_SECONDS=600
