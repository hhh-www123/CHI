  "templates": [
    {
      "id": "retention-budget-hotel",
      "family": "instruction_retention",
      "title": "预算与酒店保护的长期保持",
      "singleTurnInstruction": "总预算不得超过3000元，酒店保持不变；在这些条件下，只把第三天第二个景点描述改得更轻松。",
      "setupInstruction": "从现在起总预算不得超过3000元，当前酒店保持不变并锁定；后续没有明确解除时始终遵守。",
      "setupTarget": {"kind": "global", "component": "budget-and-hotel"},
      "setupFields": ["none"],
      "setupExpectedBehavior": "edit",
      "setupCandidateTargetCount": null,
      "trustedSetupActions": [{"kind": "set_max_budget", "value": 3000}, {"kind": "lock_hotel"}],
      "probeInstruction": "只把第三天第二个景点描述改得更轻松。",
      "probeTarget": {"kind": "activity", "dayKey": "day3", "stopId": "day3-stop-2"},
      "probeFields": ["description"],
      "probeCandidateTargetCount": 3,
      "distractorIds": ["d01", "d02", "d03", "d04", "d06", "d07", "d08", "d09", "d10", "d12", "d13", "d14", "d15", "d16", "d18", "d05", "d11", "d17"],
      "goalLedger": [
        {
          "id": "budget-cap-3000",
          "kind": "hard_constraint",
          "weight": 2,
          "introducedBy": "setup",
          "activeThrough": "end",
          "semanticRubric": "预算上限仍为3000且结果未超过上限。",
          "stateAssertions": [{"path": "/document/budgetLimit", "operator": "less_or_equal", "value": 3000}]
        },
        {
          "id": "preserve-hotel",
          "kind": "hard_constraint",
          "weight": 2,
          "introducedBy": "setup",
          "activeThrough": "end",
          "semanticRubric": "酒店选择和酒店锁均保持。",
          "stateAssertions": [
            {"path": "/session/tripState/hotelId", "operator": "unchanged"}
          ]
        }
      ],
      "oracle": {
        "taskSuccessRubric": "仅目标描述发生期望变化，同时预算、酒店和此前有效编辑保持。",
        "probeExpectedBehavior": "edit",
        "stateAssertions": [
          {"path": "/document/budgetLimit", "operator": "less_or_equal", "value": 3000},
          {"path": "/session/tripState/hotelId", "operator": "unchanged"}
        ]
